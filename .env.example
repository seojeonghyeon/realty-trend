# ===== 필수 =====
TZ=Asia/Seoul
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://realty:change-me@db:3306/realty?charset=utf8mb4

# 세션 서명용 임의 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Claude routine 이 쓰는 토큰 (digest 읽기 + analysis/news/evals 쓰기 전용)
ROUTINE_TOKEN=change-me

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding 키)
#  - 국토교통부_아파트 매매 실거래가 상세 자료
#  - 국토교통부_아파트 전월세 실거래가 자료
#  - 행정안전부_법정동코드
MOLIT_SERVICE_KEY=

# ===== 선택 =====
# 텔레그램 알림 (A1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 카카오 로컬 REST 키 (A6: 역/학교 거리 자동 계산)
KAKAO_REST_KEY=
# 네이버 요청 간격(초)과 하루 요청 상한
NAVER_DELAY_SEC=1.5
NAVER_DAILY_LIMIT=3000
# 국토부 API 하루 호출 상한 (개발계정 10,000)
MOLIT_DAILY_LIMIT=8000
# 사이트 외부 주소 (알림 링크용)
PUBLIC_BASE_URL=https://example.com
